<#import "parts/main.ftlh" as c>
<@c.page>
    <section class="u-clearfix u-section-1" id="sec-15f9">
        <div class="u-clearfix u-sheet u-sheet-1">
            <h2 align="center">Добро пожаловать в команду ГАУ ИНПЦ "Гормедтехника"</h2>

            <div class="pb-wrap">
                <p class="pb-section-sub">Всё, что пригодится в первые дни: презентация компании, рабочие сервисы и документы для ознакомления</p>

                <div class="pb-hero">
                    <#-- Презентация -->
                    <div class="pb-hero-card">
                        <a class="pb-hero-media" href="docs/Presentation.pdf" target="_blank" rel="noopener">
                            <img src="img/preza.png" alt="Презентация ГАУ ИНПЦ «Гормедтехника»"
                                 width="1021" height="560" loading="lazy">
                        </a>
                        <a class="pb-hero-caption" href="docs/Presentation.pdf" target="_blank" rel="noopener">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                <polyline points="14 2 14 8 20 8"/>
                            </svg>
                            <span>Открыть презентацию о компании (PDF)</span>
                        </a>
                    </div>

                    <#-- Полезные ссылки -->
                    <div class="pb-hero-card pb-links">
                        <h4 class="pb-links-title">Полезные ссылки</h4>

                        <a class="pb-link" href="https://xn--80afddbsolmfw1a4b.xn--p1ai/" target="_blank" rel="noopener">
                            <span class="pb-link-icon">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                    <circle cx="12" cy="12" r="9"/>
                                    <path d="M3 12h18M12 3a15 15 0 0 1 0 18a15 15 0 0 1 0-18z"/>
                                </svg>
                            </span>
                            <span class="pb-link-text">
                                Официальный сайт
                                <span class="pb-link-sub">ГАУ ИНПЦ «Гормедтехника»</span>
                            </span>
                            <svg class="pb-link-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <path d="M9 18l6-6-6-6"/>
                            </svg>
                        </a>

                        <a class="pb-link" href="https://support.gmtmsk.ru/portal" target="_blank" rel="noopener">
                            <span class="pb-link-icon">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                    <path d="M14.7 6.3a5 5 0 0 0-7 7l-6 6 1 1 6-6a5 5 0 0 0 7-7l-3 3-2-2z"/>
                                </svg>
                            </span>
                            <span class="pb-link-text">
                                Техническая поддержка
                                <span class="pb-link-sub">Сервис-деск ГМТ</span>
                            </span>
                            <svg class="pb-link-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <path d="M9 18l6-6-6-6"/>
                            </svg>
                        </a>

                        <a class="pb-link" href="https://mosedo.mos.ru/auth.php?uri=%2F" target="_blank" rel="noopener">
                            <span class="pb-link-icon">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                    <polyline points="14 2 14 8 20 8"/>
                                    <line x1="8" y1="13" x2="16" y2="13"/>
                                    <line x1="8" y1="17" x2="14" y2="17"/>
                                </svg>
                            </span>
                            <span class="pb-link-text">
                                МосЭДО
                                <span class="pb-link-sub">Электронный документооборот</span>
                            </span>
                            <svg class="pb-link-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <path d="M9 18l6-6-6-6"/>
                            </svg>
                        </a>

                        <a class="pb-link qr-hover" href="https://t.me/gmtmsk_bot" target="_blank" rel="noopener">
                            <span class="pb-link-icon">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                    <path d="M21 4L3 11l5 2 2 6 3-4 5 4z"/>
                                    <path d="M8 13l9-7-6 9"/>
                                </svg>
                            </span>
                            <span class="pb-link-text">
                                Закрытый телеграм-канал
                                <span class="pb-link-sub">Новости ГАУ ИНПЦ «Гормедтехника»</span>
                            </span>
                            <svg class="pb-link-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <path d="M9 18l6-6-6-6"/>
                            </svg>
                        </a>

                        <a class="pb-link" href="https://t.me/gmtsport25" target="_blank" rel="noopener">
                            <span class="pb-link-icon">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                    <circle cx="12" cy="12" r="9"/>
                                    <path d="M12 3a9 9 0 0 0 0 18M12 3a9 9 0 0 1 0 18M3.5 9h17M3.5 15h17"/>
                                </svg>
                            </span>
                            <span class="pb-link-text">
                                Спортивное сообщество
                                <span class="pb-link-sub">Телеграм-канал коллег</span>
                            </span>
                            <svg class="pb-link-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <path d="M9 18l6-6-6-6"/>
                            </svg>
                        </a>
                    </div>
                </div>

                <h3 align="center">Пожалуйста, ознакомьтесь с полезными документами</h3>

                <#if docs?? && docs?has_content>
                    <div class="pb-toolbar">
                        <div class="pb-search">
                            <svg class="pb-search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/>
                                <path d="M21 21l-4.3-4.3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                            </svg>
                            <input type="text" id="docs-search-input" autocomplete="off" placeholder="Поиск по названию документа...">
                            <button type="button" id="docs-search-clear" class="pb-search-clear" aria-label="Очистить поиск">&times;</button>
                        </div>
                        <div class="pb-count" id="docs-count"></div>
                    </div>

                    <div class="pb-table-card">
                        <table class="pb-table pb-table-docs" id="text-table">
                            <thead>
                            <tr>
                                <th>Наименование документа</th>
                                <th class="pb-col-go"></th>
                            </tr>
                            </thead>
                            <tbody>
                            <#list docs as doc>
                                <tr class="pb-row" data-href="/for-new-emp/${doc}" data-search="${doc?lower_case}">
                                    <td class="pb-col-doc">
                                        <div class="pb-doc-name">
                                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                                <polyline points="14 2 14 8 20 8"/>
                                                <line x1="8" y1="13" x2="16" y2="13"/>
                                                <line x1="8" y1="17" x2="14" y2="17"/>
                                            </svg>
                                            <span>${doc}</span>
                                        </div>
                                    </td>
                                    <td class="pb-col-go">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                            <path d="M9 18l6-6-6-6"/>
                                        </svg>
                                    </td>
                                </tr>
                            </#list>
                            </tbody>
                        </table>
                        <div class="pb-empty" id="docs-empty" style="display:none">
                            <p>Ничего не найдено</p>
                            <span>Попробуйте изменить запрос</span>
                        </div>
                    </div>
                <#else>
                    <div class="pb-table-card">
                        <div class="pb-empty" style="display:flex">
                            <p>Документов пока нет</p>
                            <span>Они появятся здесь, как только их добавят</span>
                        </div>
                    </div>
                </#if>
            </div>
        </div>
    </section>

    <script>
        (function () {
            const table = document.getElementById('text-table');
            if (!table) return;

            const rows = Array.prototype.slice.call(table.querySelectorAll('tbody tr.pb-row'));
            const input = document.getElementById('docs-search-input');
            const clearBtn = document.getElementById('docs-search-clear');
            const emptyEl = document.getElementById('docs-empty');
            const countEl = document.getElementById('docs-count');

            rows.forEach(function (row) {
                row.addEventListener('click', function () {
                    const href = row.dataset.href;
                    if (href) window.location = href;
                });
            });

            function apply() {
                const q = input.value.trim().toLowerCase();
                let visible = 0;
                rows.forEach(function (row) {
                    const show = !q || row.dataset.search.indexOf(q) !== -1;
                    row.style.display = show ? '' : 'none';
                    if (show) visible++;
                });
                emptyEl.style.display = visible === 0 ? 'flex' : 'none';
                table.style.display = visible === 0 ? 'none' : '';
                countEl.textContent = visible + ' из ' + rows.length + ' документов';
                clearBtn.style.display = q ? 'flex' : 'none';
            }

            input.addEventListener('input', apply);
            clearBtn.addEventListener('click', function () {
                input.value = '';
                input.focus();
                apply();
            });

            apply();
        })();
    </script>
</@c.page>
